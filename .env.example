# Public, read-only Phase 1A endpoints. These values are not secrets.
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
XRPL_TESTNET_URL=wss://s.altnet.rippletest.net:51233
FDC_VERIFIER_URL=https://fdc-verifiers-testnet.flare.network/verifier/xrp

# Optional Phase 8 browser override for the Coston2 RPC. Public value, safe to expose.
# Leave unset to use the default public endpoint bundled with the app.
NEXT_PUBLIC_COSTON2_RPC_URL=

# Supabase public project settings. The publishable key is safe only with RLS enabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Never prefix with NEXT_PUBLIC_ or expose this value to a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend-only Phase 3B settings.
INTERNAL_API_SECRET=replace-with-a-long-random-secret
INDEXER_START_BLOCK=34013106
# coston2-api.flare.network caps eth_getLogs at 30 blocks per call; keep this below that.
INDEXER_BATCH_SIZE=25
INDEXER_POLL_INTERVAL_MS=15000

# Phase 1B wallet seeds belong only in the gitignored local .env file.
XRPL_TESTNET_PAYER_SEED=
XRPL_TESTNET_RECIPIENT_SEED=

# Optional Phase 6 Xaman payload API credentials. Server only, never exposed to the browser.
# When unset, the payment-request endpoint returns only the copyable XRPL transaction JSON.
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Optional Phase 7 executor key. Coston2 EOA funded only for gas; never holds user XRP or FXRP
# and cannot redirect settlement funds (the contract calculates the valid recipient). When
# unset, FDC jobs prepare and poll normally but pause at request/proof submission.
COSTON2_EXECUTOR_PRIVATE_KEY=
