# Public, read-only Phase 1A endpoints. These values are not secrets.
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
XRPL_TESTNET_URL=wss://s.altnet.rippletest.net:51233
FDC_VERIFIER_URL=https://fdc-verifiers-testnet.flare.network/verifier/xrp

# Supabase public project settings. The publishable key is safe only with RLS enabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Never prefix with NEXT_PUBLIC_ or expose this value to a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phase 1B wallet seeds belong only in the gitignored local .env file.
XRPL_TESTNET_PAYER_SEED=
XRPL_TESTNET_RECIPIENT_SEED=
