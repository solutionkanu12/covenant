{
  "name": "covenant",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @covenant/shared build && pnpm --filter @covenant/api build && pnpm --filter @covenant/web build",
    "build:api": "pnpm --filter @covenant/shared build && pnpm --filter @covenant/api build",
    "build:web": "pnpm --filter @covenant/shared build && pnpm --filter @covenant/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:contracts": "pnpm --dir packages/contracts test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
